APP_NAME="EcoVillage.id"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Daftar CIDR reverse proxy/load balancer yang boleh dipercaya untuk header
# X-Forwarded-*, dipisahkan koma. Wajib diisi bila TLS diterminasi di depan
# aplikasi; tanpa ini HSTS tidak terkirim dan audit log menyimpan IP proxy.
# Gunakan `*` hanya bila PHP-FPM tidak dapat dijangkau langsung dari internet.
TRUSTED_PROXIES=

# Setel `false` bila deployment belum memiliki mailer. Akun baru langsung
# ditandai terverifikasi sehingga alur pokok tidak berhenti di halaman
# verifikasi, dan middleware `verified` berhenti memblokir.
REQUIRE_EMAIL_VERIFICATION=true

# Halaman daftar menjawab email yang sudah terdaftar dengan hasil yang sama
# seperti pendaftaran baru, lalu memberi tahu pemilik akun lewat email.
NEUTRAL_REGISTRATION_RESPONSE=true

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ecovillage
DB_USERNAME=ecovillage
DB_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_PASSWORD
# Hanya dipakai container MySQL pada compose.yaml, bukan oleh aplikasi.
DB_ROOT_PASSWORD=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_PASSWORD

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=ecovillage

PRIVATE_UPLOAD_DISK=local
UPLOAD_MAX_IMAGE_KB=5120

# Baseline demo lokal; review ambang agregasi/precision sebelum production.
PUBLIC_MAP_MINIMUM_RECORDS=3
PUBLIC_MAP_COORDINATE_PRECISION=2

HAZARDOUS_PARTNER_CONFIGURED=false
HAZARDOUS_CONTACT_NAME="Pengelola Eco Village"
HAZARDOUS_CONTACT_URL=

DEMO_ACCOUNTS_ENABLED=false
DEMO_USER_PASSWORD=CHANGE_ME_BEFORE_ENABLING_DEMO_ACCOUNTS

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME_WITH_A_DIFFERENT_RANDOM_PASSWORD
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# `log` bekerja tanpa layanan apa pun: seluruh pesan, termasuk tautan
# verifikasi dan setel ulang kata sandi, ditulis ke storage/logs/laravel.log.
# Gunakan `failover` (SMTP lalu log) bila SMTP sudah tersedia agar kegagalan
# transport tidak pernah menjatuhkan pendaftaran.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-3
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Content Security Policy aktif secara baku dan memakai nonce per request.
# Kebijakan tidak ditegakkan selama server Vite berjalan, karena aset dev
# dilayani dari origin lain yang tidak selalu dapat dinyatakan CSP.
# `CSP_REPORT_ONLY=true` dipakai saat menguji perubahan kebijakan.
CSP_ENABLED=true
CSP_REPORT_ONLY=false

VITE_APP_NAME="${APP_NAME}"
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Origin tambahan yang melayani tile/sprite peta bila berbeda dari host
# VITE_MAP_STYLE_URL, dipisahkan koma. Masuk ke img-src dan connect-src pada
# CSP; peta akan kosong bila origin tile tidak terdaftar.
MAP_TILE_ORIGINS=

# Hanya untuk port host Docker Compose; layanan internal tetap memakai port baku.
APP_HTTP_PORT=8080
VITE_PORT=5173
DB_FORWARD_PORT=3306
REDIS_FORWARD_PORT=6379

# Render sisi server. Biarkan aktif; bila prosesnya mati Inertia otomatis
# jatuh ke render peramban, halaman tetap berfungsi tanpa HTML awal.
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714

# Super admin dan pengelola wajib memasang autentikasi dua faktor sebelum
# membuka menu pengelolaan. Matikan hanya pada environment demo/pengujian.
REQUIRE_TWO_FACTOR_FOR_PRIVILEGED=false
