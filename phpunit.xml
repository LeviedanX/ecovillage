<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!--
            Berkas `.env` di repositori ini berisi nilai production. Tanpa
            penguncian di bawah, nilai itu ikut terbaca saat pengujian: URL
            kanonis mengikuti domain server, seluruh proxy dipercaya, dan alur
            pendaftaran berubah. Test harus berdiri di atas nilai yang tetap,
            bukan pada isi environment mesin yang menjalankannya.
        -->
        <env name="APP_URL" value="http://localhost"/>
        <env name="TRUSTED_PROXIES" value=""/>
        <env name="REQUIRE_EMAIL_VERIFICATION" value="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3308"/>
        <env name="DB_DATABASE" value="ecovillage_id_test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Penegakan 2FA untuk role istimewa diuji khusus pada
             PrivilegedTwoFactorTest, yang menyalakannya sendiri. Dibiarkan
             aktif di sini, seluruh test admin lain akan tertahan redirect. -->
        <env name="REQUIRE_TWO_FACTOR_FOR_PRIVILEGED" value="false"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
